@page "/configuracoes"
@layout MainLayout

<div class="configuracoes @(modoEscuro ? "tema-escuro" : "")">

    <div class="config-header">
        <h1>Configurações</h1>
        <p>Gerencie as configurações do sistema HealthFlow.</p>
    </div>

    <div class="config-grid">

        <!-- PERFIL -->

        <div class="config-card">

            <div class="config-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21C4 16.5 7.5 14 12 14C16.5 14 20 16.5 20 21" />
                </svg>
            </div>

            <div class="config-content">

                <h2>Perfil</h2>

                <p>
                    Informações do usuário conectado.
                </p>

                <div class="info">
                    <span>Usuário</span>
                    <strong>Usuário HealthFlow</strong>
                </div>

                <div class="info">
                    <span>E-mail</span>
                    <strong>usuario@healthflow.com</strong>
                </div>

                <div class="info">
                    <span>Tipo de usuário</span>
                    <strong>Paciente</strong>
                </div>

            </div>

        </div>


        <!-- APARÊNCIA -->

        <div class="config-card">

            <div class="config-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M21 15.5A9 9 0 0 1 8.5 3A9 9 0 1 0 21 15.5Z" />
                </svg>
            </div>

            <div class="config-content">

                <h2>Aparência</h2>

                <p>
                    Escolha o modo de exibição do sistema.
                </p>

                <div class="dark-option">

                    <div>
                        <strong>Modo escuro</strong>

                        <small>
                            Alterar as cores de todas as páginas.
                        </small>
                    </div>

                    <label class="switch">

                        <input type="checkbox"
                               @bind="modoEscuro"
                               @bind:after="AlterarTema" />

                        <span class="slider"></span>

                    </label>

                </div>

            </div>

        </div>


        <!-- SUPORTE -->

        <div class="config-card">

            <div class="config-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M21 11.5A8.5 8.5 0 0 1 12 20A8.5 8.5 0 0 1 5.5 17L3 18L4 14.5A8 8 0 1 1 21 11.5Z" />
                </svg>
            </div>

            <div class="config-content">

                <h2>Suporte</h2>

                <p>
                    Entre em contato com nossa equipe pelo WhatsApp.
                </p>

                <a class="whatsapp"
                   href="https://wa.me/5569993511256"
                   target="_blank">

                    Falar pelo WhatsApp

                </a>

            </div>

        </div>


        <!-- SOBRE -->

        <div class="config-card">

            <div class="config-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 11V16" />
                    <path d="M12 8H12.01" />
                </svg>
            </div>

            <div class="config-content">

                <h2>Sobre o HealthFlow</h2>

                <p>
                    Sistema desenvolvido para auxiliar no
                    gerenciamento de clínicas e atendimentos.
                </p>

                <div class="system-status">

                    <span></span>

                    Sistema funcionando normalmente

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    private bool modoEscuro = false;

    private void AlterarTema()
    {
        // O tema é controlado pela classe da página.
    }

}


<style>

    .configuracoes {
        min-height: 100vh;
        background: #F4F8FC;
        color: #172033;
        padding-bottom: 40px;
        transition: all 0.3s ease;
    }

    .config-header {
        margin-bottom: 30px;
    }

        .config-header h1 {
            margin: 0 0 8px 0;
            color: #0878C9;
            font-size: 32px;
        }

        .config-header p {
            margin: 0;
            color: #687386;
            font-size: 15px;
        }


    /* GRID */

    .config-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }


    /* CARD */

    .config-card {
        background: white;
        border: 1px solid #e2eaf2;
        border-radius: 16px;
        padding: 25px;
        display: flex;
        gap: 18px;
        box-shadow: 0 5px 18px rgba(0, 80, 140, 0.08);
        transition: all 0.3s ease;
    }


    /* ÍCONE */

    .config-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f5ff;
        color: #0878C9;
        border-radius: 12px;
    }

        .config-icon svg {
            width: 25px;
            height: 25px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


    /* CONTEÚDO */

    .config-content {
        flex: 1;
    }

        .config-content h2 {
            margin: 0 0 7px 0;
            color: #172033;
            font-size: 20px;
        }

        .config-content > p {
            margin: 0 0 20px 0;
            color: #687386;
            font-size: 14px;
            line-height: 1.5;
        }


    /* INFORMAÇÕES */

    .info {
        display: flex;
        justify-content: space-between;
        padding: 11px 0;
        border-bottom: 1px solid #edf1f5;
    }

        .info span {
            color: #7b8798;
            font-size: 13px;
        }

        .info strong {
            color: #172033;
            font-size: 14px;
        }


    /* MODO ESCURO */

    .tema-escuro {
        background: #080d14 !important;
        color: white !important;
    }

        .tema-escuro .config-header h1 {
            color: white !important;
        }

        .tema-escuro .config-header p {
            color: #c4ceda !important;
        }

        .tema-escuro .config-card {
            background: #151d29 !important;
            border-color: #2b394b !important;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.25);
        }

        .tema-escuro .config-content h2 {
            color: white !important;
        }

        .tema-escuro .config-content > p {
            color: #c4ceda !important;
        }

        .tema-escuro .config-icon {
            background: #20354d;
            color: white;
        }

        .tema-escuro .info {
            border-color: #2b394b;
        }

            .tema-escuro .info span {
                color: #aeb9c7;
            }

            .tema-escuro .info strong {
                color: white;
            }

        .tema-escuro .dark-option {
            background: #202b3a;
        }

            .tema-escuro .dark-option strong {
                color: white;
            }

            .tema-escuro .dark-option small {
                color: #b9c4d1;
            }

        .tema-escuro .system-status {
            color: #dce3eb;
        }


    /* OPÇÃO DO MODO ESCURO */

    .dark-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f5f8fb;
        padding: 15px;
        border-radius: 12px;
    }

        .dark-option strong {
            display: block;
            color: #172033;
            font-size: 14px;
        }

        .dark-option small {
            display: block;
            margin-top: 5px;
            color: #7b8798;
            font-size: 12px;
        }


    /* BOTÃO */

    .switch {
        position: relative;
        width: 50px;
        height: 27px;
        flex-shrink: 0;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        inset: 0;
        background: #cbd5e1;
        border-radius: 30px;
        cursor: pointer;
        transition: 0.3s;
    }

        .slider::before {
            content: "";
            position: absolute;
            width: 21px;
            height: 21px;
            left: 3px;
            top: 3px;
            background: white;
            border-radius: 50%;
            transition: 0.3s;
        }

    .switch input:checked + .slider {
        background: #0878C9;
    }

        .switch input:checked + .slider::before {
            transform: translateX(23px);
        }


    /* WHATSAPP */

    .whatsapp {
        display: inline-block;
        padding: 12px 18px;
        background: #20a86b;
        color: white !important;
        text-decoration: none;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        transition: 0.2s;
    }

        .whatsapp:hover {
            background: #168d58;
            color: white !important;
        }


    /* STATUS */

    .system-status {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 20px;
        color: #687386;
        font-size: 13px;
    }

        .system-status span {
            width: 9px;
            height: 9px;
            background: #20a86b;
            border-radius: 50%;
        }


    

</style>