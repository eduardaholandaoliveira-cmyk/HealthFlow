@page "/financeiro"

@rendermode InteractiveServer

@layout MainLayout

@using HealthFlow.DAO
@using HealthFlow.Models

@inject FinanceiroDAO FinanceiroDAO

<PageTitle>Financeiro - HealthFlow</PageTitle>

<div class="financeiro-page">

    <div class="cabecalho">

        <div>
            <h1>Financeiro</h1>

            <p>
                Controle dos valores recebidos pela clínica.
            </p>
        </div>

    </div>

    <div class="resumo">

        <div class="resumo-card">

            <div class="icone verde">
                R$
            </div>

            <div>
                <span>Total recebido</span>

                <strong>
                    R$ @totalRecebido.ToString("N2")
                </strong>
            </div>

        </div>

        <div class="resumo-card">

            <div class="icone azul">
                #
            </div>

            <div>
                <span>Pagamentos registrados</span>

                <strong>
                    @quantidadePagamentos
                </strong>
            </div>

        </div>

        <div class="resumo-card">

            <div class="icone ciano">
                R$
            </div>

            <div>
                <span>Média por pagamento</span>

                <strong>
                    R$ @mediaPagamento.ToString("N2")
                </strong>
            </div>

        </div>

    </div>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="@classeMensagem">
            @mensagem
        </div>
    }

    <div class="card cadastro-pagamento">

        <h2>Registrar pagamento</h2>

        <p>
            Adicione um novo valor recebido pela clínica.
        </p>

        <div class="formulario">

            <div class="campo">

                <label>Especialidade</label>

                <select @bind="especialidadeSelecionada">

                    <option value="">
                        Selecione uma especialidade
                    </option>

                    <option value="Ortopedia">
                        Ortopedia
                    </option>

                    <option value="Cardiologia">
                        Cardiologia
                    </option>

                    <option value="Pediatria">
                        Pediatria
                    </option>

                    <option value="Dermatologia">
                        Dermatologia
                    </option>

                    <option value="Clínica Geral">
                        Clínica Geral
                    </option>

                    <option value="Neurologia">
                        Neurologia
                    </option>

                    <option value="Ginecologia">
                        Ginecologia
                    </option>

                    <option value="Outra">
                        Outra
                    </option>

                </select>

            </div>

            <div class="campo">

                <label>Valor recebido</label>

                <input type="number"
                       step="0.01"
                       min="0"
                       @bind="valorRecebido"
                       placeholder="Ex: 250,00" />

            </div>

            <button type="button"
                    class="botao-adicionar"
                    @onclick="AdicionarPagamento"
                    disabled="@salvando">

                @if (salvando)
                {
                    <span>Salvando...</span>
                }
                else
                {
                    <span>Adicionar pagamento</span>
                }

            </button>

        </div>

    </div>

    <div class="card">

        <h2>Valores por especialidade</h2>

        <p>
            Veja quanto cada área recebeu.
        </p>

        @if (pagamentos.Count == 0)
        {
            <div class="vazio">
                Nenhum pagamento registrado ainda.
            </div>
        }
        else
        {
            <div class="lista-pagamentos">

                @foreach (var pagamento in pagamentos)
                {
                    <div class="pagamento">

                        <div class="pagamento-info">

                            <strong>
                                @pagamento.Descricao
                            </strong>

                            <span>
                                @pagamento.Status
                            </span>

                        </div>

                        <strong class="valor">
                            R$ @pagamento.Valor.ToString("N2")
                        </strong>

                    </div>
                }

            </div>
        }

    </div>

</div>

<style>

    .financeiro-page {
        width: 100%;
    }

    .cabecalho {
        margin-bottom: 25px;
    }

        .cabecalho h1 {
            margin: 0;
            color: #0878C9;
            font-size: 32px;
        }

        .cabecalho p {
            margin-top: 7px;
            color: #64748b;
        }

    .resumo {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .resumo-card {
        background: white;
        border-radius: 12px;
        padding: 25px 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.07);
    }

        .resumo-card span {
            display: block;
            color: #64748b;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .resumo-card strong {
            display: block;
            color: #111827;
            font-size: 21px;
        }

    .icone {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .verde {
        background: #e1f5ee;
        color: #159570;
    }

    .azul {
        background: #e4f1fc;
        color: #0878C9;
    }

    .ciano {
        background: #e4f7f8;
        color: #0795a0;
    }

    .card {
        background: white;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.07);
    }

        .card h2 {
            margin: 0;
            color: #172033;
            font-size: 20px;
        }

        .card > p {
            margin-top: 7px;
            margin-bottom: 25px;
            color: #64748b;
        }

    .formulario {
        display: grid;
        grid-template-columns: 1.2fr 1fr auto;
        gap: 15px;
        align-items: end;
    }

    .campo label {
        display: block;
        margin-bottom: 7px;
        color: #172033;
        font-size: 14px;
        font-weight: 600;
    }

    .campo select,
    .campo input {
        width: 100%;
        height: 45px;
        padding: 0 14px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        background: white;
        box-sizing: border-box;
        font-size: 14px;
        color: #172033;
    }

        .campo select:focus,
        .campo input:focus {
            outline: none;
            border-color: #0878C9;
            box-shadow: 0 0 0 2px rgba(8, 120, 201, 0.1);
        }

    .botao-adicionar {
        height: 45px;
        padding: 0 22px;
        border: none;
        border-radius: 7px;
        background: #0878C9;
        color: white;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }

        .botao-adicionar:hover {
            background: #0057A8;
        }

        .botao-adicionar:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .vazio {
        background: #f7f9fc;
        border-radius: 8px;
        padding: 35px;
        text-align: center;
        color: #64748b;
    }

    .lista-pagamentos {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .pagamento {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        background: #f8fafc;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }

    .pagamento-info strong {
        display: block;
        color: #172033;
        margin-bottom: 5px;
    }

    .pagamento-info span {
        font-size: 13px;
        color: #64748b;
    }

    .valor {
        color: #0878C9;
        font-size: 17px;
    }

    .mensagem-sucesso {
        background: #d4edda;
        color: #155724;
        padding: 12px 15px;
        border-radius: 7px;
        margin-bottom: 20px;
    }

    .mensagem-erro {
        background: #f8d7da;
        color: #721c24;
        padding: 12px 15px;
        border-radius: 7px;
        margin-bottom: 20px;
    }

  

</style>

@code {

    private List<FinanceiroModel> pagamentos = new();

    private string especialidadeSelecionada = "";

    private decimal valorRecebido;

    private decimal totalRecebido;

    private int quantidadePagamentos;

    private decimal mediaPagamento;

    private bool salvando = false;

    private string mensagem = "";

    private string classeMensagem = "";

    protected override void OnInitialized()
    {
        CarregarFinanceiro();
    }

    private void CarregarFinanceiro()
    {
        try
        {
            pagamentos = FinanceiroDAO.Listar();

            totalRecebido = FinanceiroDAO.TotalRecebido();

            quantidadePagamentos = FinanceiroDAO.QuantidadePagamentos();

            mediaPagamento = FinanceiroDAO.MediaPagamento();
        }
        catch (Exception ex)
        {
            mensagem = "Erro ao carregar o financeiro: " + ex.Message;

            classeMensagem = "mensagem-erro";
        }
    }

    private void AdicionarPagamento()
    {
        mensagem = "";

        classeMensagem = "";

        if (string.IsNullOrWhiteSpace(especialidadeSelecionada))
        {
            mensagem = "Selecione uma especialidade.";

            classeMensagem = "mensagem-erro";

            return;
        }

        if (valorRecebido <= 0)
        {
            mensagem = "Informe um valor maior que zero.";

            classeMensagem = "mensagem-erro";

            return;
        }

        salvando = true;

        try
        {
            var financeiro = new FinanceiroModel
            {
                Descricao = especialidadeSelecionada,
                Valor = valorRecebido,
                FormaPagamento = "Não informado",
                Status = "Recebido"
            };

            FinanceiroDAO.Inserir(financeiro);

            especialidadeSelecionada = "";

            valorRecebido = 0;

            mensagem = "Pagamento cadastrado com sucesso!";

            classeMensagem = "mensagem-sucesso";

            CarregarFinanceiro();
        }
        catch (Exception ex)
        {
            mensagem = "Erro ao cadastrar pagamento: " + ex.Message;

            classeMensagem = "mensagem-erro";
        }
        finally
        {
            salvando = false;
        }
    }

}