@page "/"
@layout EmptyLayout

@using HealthFlow.DAO
@using HealthFlow.Models

@inject NavigationManager NavigationManager
@inject UsuarioDAO UsuarioDAO

@rendermode InteractiveServer

<div class="login-container">

    ```
    <div class="login-card">

        <div class="login-logo">
            <img src="imagens/foto de healtflow.jpeg"
                 alt="HealthFlow"
                 class="logo-img" />
        </div>

        <h1 class="login-title">HealthFlow</h1>

        <p class="login-subtitle">
            Sistema Clínico da Clínica
        </p>

        <div class="login-form">

            <div class="form-group">
                <label for="email">E-mail</label>

                <input type="email"
                       id="email"
                       @bind="email"
                       class="form-control"
                       placeholder="Usuario@email.com" />
            </div>

            <div class="form-group">
                <label for="senha">Senha</label>

                <input type="password"
                       id="senha"
                       @bind="senha"
                       class="form-control"
                       placeholder="Sua senha" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">
                    ⚠️ @errorMessage
                </div>
            }

            <button type="button"
                    class="btn-login"
                    @onclick="HandleLogin"
                    disabled="@isLoading">

                @if (isLoading)
                {
                    <span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }

            </button>

            <button type="button"
                    class="btn-cadastro"
                    @onclick="IrParaCadastro">

                Criar uma conta

            </button>

        </div>

        <p class="login-footer">
            © 2024 HealthFlow - Todos os direitos reservados
        </p>

    </div>
    ```

</div>

@code {


private string email = "";
    private string senha = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private void HandleLogin()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            if (string.IsNullOrWhiteSpace(email) ||
                string.IsNullOrWhiteSpace(senha))
            {
                errorMessage = "Digite o e-mail e a senha.";
                return;
            }

            var usuario = UsuarioDAO.Login(email, senha);

            if (usuario != null)
            {
                NavigationManager.NavigateTo("/home");
            }
            else
            {
                errorMessage = "E-mail ou senha incorretos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao realizar login: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void IrParaCadastro()
    {
        NavigationManager.NavigateTo("/cadastro");
    }


}

<style>

    .error-message {
        background: #f8d7da;
        color: #721c24;
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 15px;
        border: 1px solid #f5c6cb;
    }

    .btn-cadastro {
        width: 100%;
        padding: 12px;
        margin-top: 12px;
        border: 1px solid #7b2cbf;
        border-radius: 7px;
        background: transparent;
        color: white;
        font-size: 15px;
        cursor: pointer;
    }

        .btn-cadastro:hover {
            background: #7b2cbf;
        }

</style>
