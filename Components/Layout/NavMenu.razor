</div>

<style>

    .sidebar {
        width: 250px;
        min-height: 100vh;

        position: fixed;
        left: 0;
        top: 0;

        display: flex;
        flex-direction: column;

        background: linear-gradient(
            180deg,
            #0878C9 0%,
            #0A9CA6 100%
        );

        color: white;

        padding: 25px 15px;

        box-sizing: border-box;

        box-shadow: 3px 0 15px rgba(0, 60, 120, 0.15);
    }


    /* Logo */

    .logo-menu {
        display: flex;
        align-items: center;

        gap: 12px;

        padding: 5px 10px 30px;

        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }


    .logo-icon {
        width: 45px;
        height: 45px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: white;

        color: #0878C9;

        border-radius: 12px;

        font-size: 15px;
        font-weight: bold;

        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    }


    .logo-menu h2 {
        margin: 0;

        font-size: 23px;

        color: white;

        letter-spacing: 0.3px;
    }


    .logo-menu p {
        margin: 3px 0 0;

        font-size: 12px;

        color: rgba(255, 255, 255, 0.85);
    }


    /* Título do menu */

    .menu-titulo {
        font-size: 10px;

        font-weight: 600;

        letter-spacing: 1px;

        color: rgba(255, 255, 255, 0.65);

        margin: 28px 12px 10px;
    }


    /* Menu */

    .menu {
        display: flex;

        flex-direction: column;

        gap: 6px;
    }


    .menu-link {
        display: flex;

        align-items: center;

        gap: 13px;

        padding: 12px 14px;

        color: rgba(255, 255, 255, 0.9);

        text-decoration: none;

        border-radius: 9px;

        font-size: 14px;

        transition: all 0.2s ease;
    }


    .menu-link:hover {
        background: rgba(255, 255, 255, 0.15);

        color: white;

        transform: translateX(3px);
    }


    .menu-link-active {
        background: rgba(255, 255, 255, 0.25);

        color: white;

        font-weight: 600;

        box-shadow: inset 3px 0 0 white;
    }


    /* Ícones */

    .icone {
        width: 21px;
        height: 21px;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;
    }


    .icone svg {
        width: 19px;
        height: 19px;

        fill: none;

        stroke: currentColor;

        stroke-width: 1.8;

        stroke-linecap: round;

        stroke-linejoin: round;
    }


    /* Área inferior */

    .menu-final {
        margin-top: auto;

        padding-top: 20px;

        border-top: 1px solid rgba(255, 255, 255, 0.2);
    }


    .btn-sair {
        display: flex;

        align-items: center;

        gap: 13px;

        padding: 12px 14px;

        color: white;

        text-decoration: none;

        border-radius: 9px;

        font-size: 14px;

        transition: all 0.2s ease;
    }


    .btn-sair:hover {
        background: rgba(255, 255, 255, 0.15);

        transform: translateX(3px);
    }


   
</style>