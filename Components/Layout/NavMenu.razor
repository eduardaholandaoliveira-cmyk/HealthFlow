<style>

    /* ==============================
           SIDEBAR
           ============================== */

    .sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        background: linear-gradient( 180deg, #0878C9 0%, #0A9CA6 100% );
        color: white;
        padding: 25px 15px;
        box-sizing: border-box;
        box-shadow: 3px 0 15px rgba(0, 60, 120, 0.18);
    }


    /* ==============================
           LOGO
           ============================== */

    .logo-menu {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 5px 8px 25px 8px;
    }

    .logo-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        color: #0878C9;
        border-radius: 12px;
        font-size: 17px;
        font-weight: 700;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    }

    .logo-text h2 {
        margin: 0;
        color: white;
        font-size: 20px;
        font-weight: 700;
    }

    .logo-text p {
        margin: 3px 0 0 0;
        color: white;
        font-size: 11px;
        opacity: 0.85;
    }


    /* ==============================
           TÍTULO DO MENU
           ============================== */

    .menu-titulo {
        padding: 10px;
        color: white;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        opacity: 0.75;
    }


    /* ==============================
           MENU
           ============================== */

    .menu {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 5px;
    }


    /* ==============================
           LINKS
           ============================== */

    .menu-link {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 13px 14px;
        box-sizing: border-box;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        position: relative;
        z-index: 1001;
        transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }


        /* PASSAR O MOUSE */

        .menu-link:hover {
            background: rgba(255, 255, 255, 0.18);
            color: white;
            transform: translateX(4px);
        }


        /* QUANDO O LINK É CLICADO */

        .menu-link:active {
            transform: translateX(2px);
        }


    /* ==============================
           ÍCONES
           ============================== */

    .icone {
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .icone svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


    /* ==============================
           PARTE INFERIOR
           ============================== */

    .menu-final {
        margin-top: auto;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.18);
    }


    /* ==============================
           BOTÃO SAIR
           ============================== */

    .btn-sair {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 13px 14px;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .btn-sair:hover {
            background: rgba(255, 255, 255, 0.18);
            color: white;
            transform: translateX(4px);
        }


        /* ==============================
           CONTEÚDO DOS LINKS
           ============================== */

        .menu-link span:last-child,
        .btn-sair span:last-child {
            white-space: nowrap;
        }

</style>